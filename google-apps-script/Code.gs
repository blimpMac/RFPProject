/**
 * RFP Desk — bound Google account script.
 * Deploy as a Web App: Execute as ME, Who has access: Anyone.
 * Configure Script Properties: RFP_SHARED_SECRET, RFP_SITE_URL.
 * Never expose the secret in front-end code, GitHub or Google Sheet cells.
 */
const SHEET_ID='1MS8PhbPQA_XbULWAefow4bMsP3s7z-KEp0K9YMJHvTE';
const FOLDER_NAME='RFP Desk Secure Attachments';
const TIMEZONE='Asia/Manila';
const DEFAULT_SUPERVISOR='dricianfranciscordon@gmail.com';
const TRACKER_HEADERS=['RFP No.','Submitted Date','Requestor Email','Requestor Name','Department','Project / Class','RFP Type','Supplier / Payee','Purpose / Description','Amount','Required Payment Date','Supporting Documents','Approving Head','Approver Email','Department Approval','Department Approval Date','Department Approval Remarks','Finance Review','Finance Review Date','Finance Remarks','Final Status','Last Action','Planned Check Date','Check Date Last Updated','Check Date Change Reason','Finance Email Thread ID'];
const RESP_HEADERS=['Timestamp','Requestor Email','Requestor Name','Department','Project / Class','RFP Type','Supplier / Payee','Purpose / Description','Amount','Required Payment Date','Supporting Documents','Approving Head'];
const LOG_HEADERS=['Timestamp','RFP No.','Action','Actor Email','Remarks','Previous Status','New Status'];

function prop(k){return PropertiesService.getScriptProperties().getProperty(k)||'';}
function answer(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){try{const p=JSON.parse(e.postData.contents||'{}');if(!prop('RFP_SHARED_SECRET')||p.secret!==prop('RFP_SHARED_SECRET'))return answer({ok:false,error:'Access denied'});const actions={submit:submitRequest,review:loadReview,decide:recordDecision,dashboard:loadDashboard};if(!actions[p.action])throw Error('Unknown action');return answer(actions[p.action](p));}catch(err){console.error(err.stack||err);return answer({ok:false,error:String(err.message||err)});}}
function tab(name){const sheet=SpreadsheetApp.openById(SHEET_ID).getSheetByName(name);if(!sheet)throw Error('Missing sheet: '+name);return sheet;}
function stamp(){return Utilities.formatDate(new Date(),TIMEZONE,'M/d/yyyy HH:mm:ss');}
function norm(v){return String(v==null?'':v).trim().replace(/^\s*-\s*/, '');}
function rows(sheet){const last=sheet.getLastRow();return last>1?sheet.getRange(2,1,last-1,sheet.getLastColumn()).getDisplayValues():[];}
function rowById(id){const s=tab('RFP Tracker');const arr=rows(s);for(let i=0;i<arr.length;i++){if(arr[i][0]===id)return {sheet:s,number:i+2,data:arr[i]};}throw Error('Request not found');}
function mapRow(a){return {id:a[0],submittedDate:a[1],requestorEmail:a[2],requestorName:a[3],department:norm(a[4]),project:a[5],rfpType:norm(a[6]),payee:a[7],purpose:a[8],amount:a[9],requiredDate:a[10],files:parseLinks(a[11]),approvingHead:a[12],approverEmail:a[13],departmentApproval:a[14]||'Pending',departmentApprovalDate:a[15],departmentRemarks:a[16],financeReview:a[17],financeReviewDate:a[18],financeRemarks:a[19],finalStatus:a[20],lastAction:a[21]};}
function parseLinks(value){return String(value||'').split(/\s*[\n,]\s*/).filter(x=>/^https:\/\/drive\.google\.com\//.test(x)).map((url,i)=>({name:'Supporting document '+(i+1),url}));}
function nextId(){const all=rows(tab('RFP Tracker'));const n=all.reduce((m,r)=>Math.max(m,Number((String(r[0]||'').match(/^RFP-(\d+)$/)||[])[1])||0),0);return 'RFP-'+String(n+1).padStart(4,'0');}
function activeApprover(dept){const arr=rows(tab('Approver Master'));const match=arr.find(a=>norm(a[0]).toLowerCase()===norm(dept).toLowerCase()&&String(a[3]).toLowerCase()==='yes');return match?{name:match[1],email:DEFAULT_SUPERVISOR}: {name:'Pilot Approver',email:DEFAULT_SUPERVISOR};}
function folder(){const props=PropertiesService.getScriptProperties();const existing=props.getProperty('RFP_FOLDER_ID');if(existing){try{return DriveApp.getFolderById(existing)}catch(e){}}const f=DriveApp.createFolder(FOLDER_NAME);props.setProperty('RFP_FOLDER_ID',f.getId());return f;}
function validFile(f){return f&&typeof f.name==='string'&&typeof f.data==='string'&&/^(application\/pdf|image\/(jpeg|png|webp|gif|heic|heif|tiff|bmp|x-ms-bmp))$/.test(String(f.type||''));}
function createFiles(files,id){const f=folder(),created=[],blobs=[];for(let i=0;i<files.length;i++){const file=files[i];if(!validFile(file))throw Error('Unsupported file type');const bytes=Utilities.base64Decode(file.data);const blob=Utilities.newBlob(bytes,file.type,id+'_'+(i+1)+'_'+file.name.replace(/[^\w.\- ]/g,'_').slice(0,100));const saved=f.createFile(blob);saved.setDescription('Private supporting document for '+id);created.push(saved.getUrl());blobs.push(blob);}return {urls:created,blobs};}
function idToken(id){const payload=Utilities.base64EncodeWebSafe(JSON.stringify({id:id,exp:Date.now()+14*86400000})).replace(/=+$/,'');const sig=Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(payload,prop('RFP_SHARED_SECRET'))).replace(/=+$/,'');return payload+'.'+sig;}
function emailHtml(title,details,body){return '<div style="font-family:Arial,sans-serif;max-width:660px;margin:auto;color:#233a50"><div style="background:#173650;color:white;padding:22px 26px;border-radius:10px 10px 0 0"><strong style="font-size:18px">RFP Desk</strong><p style="margin:5px 0 0;opacity:.85">'+title+'</p></div><div style="padding:25px;border:1px solid #e4eaf0;border-radius:0 0 10px 10px">'+details+body+'<hr style="border:0;border-top:1px solid #e6edf2;margin:24px 0"><small style="color:#8b9ba8">Automated RFP monitoring notification</small></div></div>';}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;':'&quot;',"'":'&#39;'}[c]));}
function detailHtml(request){return '<p><b>'+esc(request.id)+'</b> • '+esc(request.department)+'</p><p><b>Requestor:</b> '+esc(request.requestorName)+' ('+esc(request.requestorEmail)+')</p><p><b>Amount:</b> PHP '+esc(request.amount)+'</p><p><b>Payee:</b> '+esc(request.payee)+'</p><p><b>Project:</b> '+esc(request.project)+'</p><p><b>Purpose:</b> '+esc(request.purpose)+'</p><p><b>Needed on:</b> '+esc(request.requiredDate)+'</p>';}
function logAction(id,action,actor,remarks,previous,next){tab('Approval Log').appendRow([stamp(),id,action,actor,remarks||'',previous||'',next]);}
function submitRequest(p){const lock=LockService.getScriptLock();lock.waitLock(26000);try{const r=p.request||{},files=p.files||[];if(!r.requestorName||!r.requestorEmail||!r.purpose||!r.department||!(Number(r.amount)>0)||!Array.isArray(files)||files.length>10)throw Error('Invalid submission');const id=nextId(),now=stamp(),ap=activeApprover(r.department),uploaded=createFiles(files,id),links=uploaded.urls.join('\n');const tracker=[id,now,r.requestorEmail,r.requestorName,r.department,r.project,r.rfpType,r.payee,r.purpose,Number(r.amount),r.requiredDate,links,ap.name,ap.email,'Pending','','','Not Started','','','Pending Department Approval','Submitted','','','',''];tab('RFP Tracker').appendRow(tracker);tab('Form Responses 1').appendRow([now,r.requestorEmail,r.requestorName,r.department,r.project,r.rfpType,r.payee,r.purpose,Number(r.amount),r.requiredDate,links,ap.name]);logAction(id,'Submitted',r.requestorEmail,'','','Pending Department Approval');const site=prop('RFP_SITE_URL').replace(/\/+$/,'');const reviewUrl=site+'/review/?token='+encodeURIComponent(idToken(id));const mapped=mapRow(tracker);let notificationWarning=false;try{let previews='<h3>Supporting documents</h3>';for(let i=0;i<uploaded.urls.length;i++){const mime=files[i].type;if(/^image\//.test(mime)&&uploaded.blobs[i].getBytes().length<1500000){previews+='<p><b>'+esc(files[i].name)+'</b></p><img src="cid:preview'+i+'" style="max-width:100%;max-height:300px;object-fit:contain;border-radius:7px">';}else{previews+='<p>📎 '+esc(files[i].name)+' (attached)</p>';}}const inline={};uploaded.blobs.forEach((blob,i)=>{if(/^image\//.test(files[i].type)&&blob.getBytes().length<1500000)inline['preview'+i]=blob;});const opts={htmlBody:emailHtml('New request awaiting approval',detailHtml(mapped),previews+'<p style="margin-top:26px"><a href="'+esc(reviewUrl)+'" style="background:#173650;color:#fff;text-decoration:none;padding:13px 19px;border-radius:7px">Review / approve / reject request</a></p><small>Decisions are confirmed on a secure website, not by opening this message.</small>'),name:'RFP Desk',attachments:uploaded.blobs,inlineImages:inline};GmailApp.sendEmail(ap.email,'RFP approval needed • '+id,'Review request: '+reviewUrl,opts);}catch(err){console.error('Supervisor mail failed for '+id+': '+err);notificationWarning=true;}return {ok:true,id,notificationWarning};}finally{lock.releaseLock();}}
function loadReview(p){return {ok:true,request:mapRow(rowById(p.id).data)};}
function recordDecision(p){const lock=LockService.getScriptLock();lock.waitLock(26000);try{const obj=rowById(p.id),s=obj.sheet,r=mapRow(obj.data);if(r.departmentApproval!=='Pending')throw Error('This request has already been reviewed');const approved=p.decision==='approve';if(!approved&&!(p.remarks||'').trim())throw Error('Rejection remarks required');const next=approved?'Pending Finance Review':'Rejected by Department',status=approved?'Approved':'Rejected';s.getRange(obj.number,15,1,3).setValues([[status,stamp(),p.remarks||'']]);s.getRange(obj.number,21,1,2).setValues([[next,approved?'Department Approved':'Department Rejected']]);logAction(p.id,approved?'Department Approved':'Department Rejected',r.approverEmail,p.remarks||'','Pending Department Approval',next);let notificationWarning=false;try{const message=approved?'Your request is approved, please wait for further instructions':'Your request is not approved, please provide documentation or clarify your reason.';GmailApp.sendEmail(r.requestorEmail,'RFP '+p.id+' • '+status,message,{name:'RFP Desk',htmlBody:emailHtml('Request status update',detailHtml(r),'<h3>'+esc(message)+'</h3><p>'+esc(p.remarks||'')+'</p>')});}catch(err){console.error('Requestor email failed: '+err);notificationWarning=true;}return {ok:true,notificationWarning,message:approved?'Department approval recorded. Finance review is the next step.':'Request rejection recorded.'};}finally{lock.releaseLock();}}
function loadDashboard(){const arr=rows(tab('RFP Tracker'));return {ok:true,requests:arr.filter(a=>/^RFP-\d+/.test(a[0])).map(mapRow)};}

/* Important: Set your Approver Master approver email to the desired address
