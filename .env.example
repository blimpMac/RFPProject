# PUBLIC: safe to expose in the Vite browser bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy compatibility only; leave unset when using the publishable key above.
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=RFP Monitoring System
VITE_SITE_URL=http://localhost:8888

# SECRET: configure in Netlify/local .env only. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Legacy compatibility only; leave unset when using the secret key above.
SUPABASE_SERVICE_ROLE_KEY=
APPROVAL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@example.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=RFP Desk <notifications@example.com>
SITE_URL=http://localhost:8888

# Optional bootstrap and operational limits.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
DEFAULT_SUPERVISOR_EMAIL=
MAX_UPLOAD_FILES=10
MAX_UPLOAD_SIZE_MB=10
REVIEW_TOKEN_HOURS=168
EMAIL_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=60
RATE_LIMIT_MAX_SUBMISSIONS=8

# Setup/migration only (do not keep in the browser or commit real values)
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
GOOGLE_SHEET_ID=1MS8PhbPQA_XbULWAefow4bMsP3s7z-KEp0K9YMJHvTE
GOOGLE_DRIVE_ACCESS_TOKEN=OPTIONAL_SHORT_LIVED_OAUTH_TOKEN
# Alternative to an OAuth token. Keep the JSON secret on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=OPTIONAL_SERVICE_ACCOUNT_JSON
