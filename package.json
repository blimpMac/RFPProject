{
  "name": "rfp-monitoring-system",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:vercel": "npx --yes vercel@latest dev",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write \"{api,scripts,server,src}/**/*.{ts,tsx,css}\" \"*.{js,json,ts}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"{api,scripts,server,src}/**/*.{ts,tsx,css}\" \"*.{js,json,ts}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml}\"",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "test": "node --experimental-strip-types --test server/lib/staff-access.test.ts server/lib/validation.test.ts server/lib/department-review-access.test.ts server/lib/digital-rfp.test.ts server/services/approving-heads.test.ts server/services/audit-trail.test.ts",
    "db:setup": "tsx scripts/setup/setup-supabase.ts",
    "db:test": "node --env-file=.env --import tsx scripts/verification/verify-database.ts",
    "migrate:workbook": "tsx scripts/migration/import-workbook.ts",
    "migrate:attachments": "tsx scripts/migration/migrate-attachments.ts",
    "migrate:verify": "tsx scripts/verification/verify-migration.ts",
    "admin:bootstrap": "tsx scripts/setup/bootstrap-admin.ts",
    "email:reconcile": "node --env-file=.env --experimental-strip-types scripts/setup/reconcile-email-queue.ts",
    "admin:promote-protected": "node --env-file=.env --experimental-strip-types scripts/setup/promote-superadmin.ts",
    "test:email-delivery": "node --env-file=.env --import tsx scripts/verification/send-test-emails.ts",
    "test:auth-email": "node --env-file=.env --import tsx scripts/verification/send-auth-recovery-tests.ts",
    "preview:capture": "node --env-file=.env --import tsx scripts/verification/capture-previews.ts",
    "verify:live-admin": "node --experimental-strip-types scripts/verification/verify-live-admin.ts",
    "verify:live-branding": "node --experimental-strip-types scripts/verification/verify-live-branding.ts",
    "verify:live-responsive": "node --env-file=.env --experimental-strip-types scripts/verification/verify-live-responsive.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-table": "^9.3.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.3.0",
    "lucide-react": "^1.56.0",
    "nodemailer": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.3.4"
  }
}
