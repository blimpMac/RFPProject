{
  "name": "rfp-monitoring-system",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:vercel": "npx --yes vercel@latest dev",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "db:setup": "tsx scripts/setup/setup-supabase.ts",
    "db:test": "tsx scripts/verification/verify-database.ts",
    "migrate:workbook": "tsx scripts/migration/import-workbook.ts",
    "migrate:attachments": "tsx scripts/migration/migrate-attachments.ts",
    "migrate:verify": "tsx scripts/verification/verify-migration.ts",
    "admin:bootstrap": "tsx scripts/setup/bootstrap-admin.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-table": "^9.3.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.3.0",
    "lucide-react": "^1.56.0",
    "nodemailer": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
