# Copy this file to .env for local development. It contains placeholders only.
# PUBLIC browser configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy compatibility only.
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=RFP Monitoring System
VITE_SITE_URL=https://YOUR_SITE.netlify.app

# PRIVATE server configuration — set as Netlify environment variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Legacy compatibility only.
SUPABASE_SERVICE_ROLE_KEY=
APPROVAL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_AUTHORIZED_SMTP_ACCOUNT
SMTP_PASSWORD=YOUR_APP_PASSWORD
SMTP_FROM_EMAIL=RFP Desk <YOUR_AUTHORIZED_SMTP_ACCOUNT>
SITE_URL=https://YOUR_SITE.netlify.app

# OPTIONAL
ADMIN_BOOTSTRAP_EMAIL=YOUR_FIRST_ADMIN_EMAIL
DEFAULT_SUPERVISOR_EMAIL=
MAX_UPLOAD_FILES=10
MAX_UPLOAD_SIZE_MB=10
REVIEW_TOKEN_HOURS=168
EMAIL_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=60
RATE_LIMIT_MAX_SUBMISSIONS=8

# SETUP/MIGRATION ONLY — remove after use.
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
GOOGLE_SHEET_ID=1MS8PhbPQA_XbULWAefow4bMsP3s7z-KEp0K9YMJHvTE
GOOGLE_DRIVE_ACCESS_TOKEN=OPTIONAL_SHORT_LIVED_OAUTH_TOKEN
GOOGLE_SERVICE_ACCOUNT_JSON=OPTIONAL_SERVICE_ACCOUNT_JSON
