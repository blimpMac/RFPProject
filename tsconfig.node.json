{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["node"],
    "composite": true, "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "api/**/*.ts", "server/**/*.ts", "scripts/**/*.ts"]
}
